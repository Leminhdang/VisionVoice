        <mxCell id="a1" value="&lt;b&gt;1.&lt;/b&gt; Nhận lệnh: khẩu lệnh &quot;chụp ảnh&quot; · phím âm lượng · nút chụp · thư viện ảnh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
