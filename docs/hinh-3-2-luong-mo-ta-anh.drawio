        <mxCell id="a2" value="&lt;b&gt;2.&lt;/b&gt; Phát âm hiệu màn trập + rung nhẹ&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;captureMachine: idle → capturing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
