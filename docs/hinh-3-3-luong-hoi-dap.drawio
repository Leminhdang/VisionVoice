        <mxCell id="q1" value="Đọc lời giới thiệu màn hình cho XONG&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rồi mới mount tầng Q&amp;amp;A — tránh câu hỏi mở đầu cắt ngang&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
