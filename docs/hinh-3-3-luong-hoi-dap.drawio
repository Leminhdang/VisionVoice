        <mxCell id="qd1" value="Là lệnh thoát?&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&quot;quay lại&quot; / &quot;dừng&quot;&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
