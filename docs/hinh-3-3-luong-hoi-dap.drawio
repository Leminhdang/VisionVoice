        </mxCell>
        <mxCell id="q3" value="&lt;b&gt;Bắt đầu nghe&lt;/b&gt; — âm hiệu bắt đầu nghe · trạng thái listening" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
