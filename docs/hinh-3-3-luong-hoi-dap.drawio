        <mxCell id="q0" value="Mở màn hỏi đáp từ ảnh vừa mô tả" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
