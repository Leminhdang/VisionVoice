  <diagram name="Hình 3.3 — Luồng hỏi đáp về ảnh" id="hinh-3-3">
    <mxGraphModel dx="1100" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1150" math="0" shadow="0">
      <root>
