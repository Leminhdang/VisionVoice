        <mxCell id="q2" value="Tạo chat session từ ảnh + đọc &quot;Bạn muốn hỏi gì về bức ảnh?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
